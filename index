<!DOCTYPE html>
<html lang="es-MX">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nota Boutique Invoice | Generador</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Librería para generar PDF en móvil -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,700;1,400&family=Instrument+Serif:ital@0;1&family=Inter:wght@300;500;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --spring-green: #97C073;   /* 30% Secondary */
            --sage-light: #F2F7ED;     /* 60% Primary (BG) */
            --daffodil: #F9E264;       /* 10% Accent (Action) */
            --charcoal: #2D3328;
            --font-display: 'Instrument Serif', serif;
            --font-interface: 'Inter', sans-serif;
        }

        body {
            font-family: var(--font-interface);
            background-color: var(--sage-light);
            color: var(--charcoal);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        .editorial-title {
            font-family: var(--font-display);
            font-style: italic;
            line-height: 0.9;
        }

        .accent-button {
            background-color: var(--daffodil);
            color: var(--charcoal);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .accent-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(249, 226, 100, 0.4);
        }

        .input-label-hint {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            font-weight: 800;
            color: var(--spring-green);
            margin-bottom: 0.5rem;
            display: block;
            margin-left: 1rem;
        }

        .editor-container {
            max-width: 900px;
            margin: 40px auto;
            padding: 20px;
            position: relative;
            z-index: 10;
        }

        .input-glass {
            background: rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(151, 192, 115, 0.2);
            border-radius: 1.5rem;
            padding: 0.8rem 1.25rem;
            width: 100%;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .input-glass:focus {
            outline: none;
            background: white;
            border-color: var(--daffodil);
            box-shadow: 0 10px 30px rgba(151, 192, 115, 0.1);
        }

        /* Wave Background */
        .wave-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--sage-light);
            z-index: -1;
        }

        .wave-shape {
            position: absolute;
            bottom: 0;
            width: 100%;
            fill: white;
        }

        /* Invoice Preview Styling */
        #preview-modal {
            display: none;
            position: fixed;
            inset: 0;
            background: white;
            z-index: 100;
            overflow-y: auto;
        }

        #preview-modal.active { display: block; }

        #invoice-preview {
            width: 210mm;
            min-height: 297mm;
            background: white;
            margin: 0 auto;
            position: relative;
            color: var(--charcoal);
            display: flex;
            flex-direction: column;
            padding: 0;
        }

        .boutique-table { width: 100%; margin-top: 4rem; border-collapse: collapse; }
        .boutique-table th {
            text-align: left;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: var(--spring-green);
            padding-bottom: 1.5rem;
            border-bottom: 2px solid var(--daffodil);
        }

        .boutique-table td {
            padding: 1.5rem 0;
            border-bottom: 1px solid var(--sage-light);
            font-size: 1.1rem;
        }

        .circle-accent {
            width: 180px;
            height: 180px;
            background: var(--daffodil);
            border-radius: 50%;
            position: absolute;
            top: -60px;
            right: -60px;
            z-index: 0;
            opacity: 0.8;
        }

        .footer-organic {
            background: linear-gradient(180deg, white 0%, var(--sage-light) 100%);
            padding: 4rem 20mm;
            margin-top: auto;
            border-radius: 6rem 6rem 0 0;
        }

        /* Loader para exportación */
        #export-loader {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(255,255,255,0.9);
            z-index: 200;
            align-items: center;
            justify-content: center;
            flex-direction: column;
        }

        @media print {
            .no-print { display: none !important; }
            #preview-modal { position: static; display: block; }
            #invoice-preview { box-shadow: none; width: 100%; padding: 0; margin: 0; }
        }

        @media (max-width: 640px) {
            #invoice-preview { width: 100%; min-height: auto; }
            .editorial-title { font-size: 4rem !important; }
            .total-container {
                flex-direction: column !important;
                align-items: flex-start !important;
                gap: 0.25rem;
            }
            .total-amount { font-size: 1.6rem !important; }
            .total-label { font-size: 1.4rem !important; }
            .footer-organic { padding: 3rem 1rem; }
        }
    </style>
</head>
<body>

    <div id="export-loader">
        <div class="w-12 h-12 border-4 border-daffodil border-t-charcoal rounded-full animate-spin mb-4"></div>
        <p class="font-display italic text-2xl">Generando tu Nota...</p>
    </div>

    <div class="wave-bg no-print">
        <svg class="wave-shape" viewBox="0 0 1440 320"><path d="M0,224L48,213.3C96,203,192,181,288,186.7C384,192,480,224,576,213.3C672,203,768,149,864,138.7C960,128,1056,160,1152,181.3C1248,203,1344,213,1392,218.7L1440,224L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>
    </div>

    <div class="fixed bottom-6 md:bottom-10 left-1/2 -translate-x-1/2 flex gap-2 md:gap-3 z-[110] no-print w-[90%] md:w-auto">
        <button onclick="togglePreview(false)" class="flex-1 md:flex-initial bg-white/90 backdrop-blur-md text-charcoal px-5 md:px-8 py-3 md:py-4 rounded-full shadow-xl font-bold border border-white hover:bg-white transition-all text-sm md:text-base">
            Diseño
        </button>
        <button onclick="togglePreview(true)" class="flex-1 md:flex-initial accent-button px-6 md:px-10 py-3 md:py-4 rounded-full shadow-xl font-bold text-sm md:text-base">
            Vista Previa
        </button>
    </div>

    <div class="editor-container no-print">
        <div class="mb-12 md:mb-16 text-center">
            <h1 class="editorial-title text-6xl md:text-8xl mb-4">Nota.</h1>
            <p class="uppercase tracking-[0.4em] text-[9px] md:text-[10px] text-spring-green font-black">Estudio de Facturación Digital</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mb-8">
            <div>
                <label class="input-label-hint">Referencia de Folio</label>
                <input type="text" id="edit-no" class="input-glass" value="#2026-001" oninput="updatePreview()">
            </div>
            <div>
                <label class="input-label-hint">Periodo de Facturación</label>
                <input type="text" id="edit-date" class="input-glass" value="Marzo 2026" oninput="updatePreview()">
            </div>
        </div>

        <div class="mb-8">
            <label class="input-label-hint">Nombre Legal o Entidad</label>
            <input type="text" id="edit-client-name" class="input-glass text-xl md:text-2xl font-display italic" value="The Botanical Club" oninput="updatePreview()">
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mb-10">
            <div>
                <label class="input-label-hint">Correo de Contacto</label>
                <input type="email" id="edit-client-email" class="input-glass" value="billing@botanical.club" oninput="updatePreview()">
            </div>
            <div>
                <label class="input-label-hint">Ubicación / Ciudad</label>
                <input type="text" id="edit-client-address" class="input-glass" value="CDMX, México" oninput="updatePreview()">
            </div>
        </div>

        <div class="bg-white/40 backdrop-blur-sm p-6 md:p-10 rounded-[2.5rem] md:rounded-[3.5rem] border border-white/60 mb-8">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8 md:mb-10">
                <div>
                    <h3 class="text-xs uppercase tracking-[0.3em] font-black text-charcoal">Conceptos</h3>
                    <p class="text-[10px] text-spring-green font-bold mt-1">Desglosa tus servicios creativos</p>
                </div>
                <button onclick="addItem()" class="accent-button w-full md:w-auto px-6 py-2 rounded-full text-xs font-bold">
                    + Nuevo Concepto
                </button>
            </div>
            <div id="items-editor-container"></div>
        </div>

        <button onclick="exportToPDF()" class="w-full bg-charcoal text-white rounded-[1.5rem] md:rounded-[2rem] py-5 md:py-8 text-lg md:text-xl font-bold hover:bg-spring-green transition-all shadow-2xl flex items-center justify-center gap-3 group">
            Exportar PDF
            <span class="group-hover:translate-x-2 transition-transform">→</span>
        </button>
        <div class="h-20"></div> 
    </div>

    <!-- Modal de Vista Previa -->
    <div id="preview-modal">
        <div id="invoice-preview-container">
            <div id="invoice-preview">
                <div class="circle-accent no-print"></div>
                
                <div class="p-8 md:p-[25mm] relative z-10 flex-1">
                    <div class="flex justify-between items-start mb-16 md:mb-32">
                        <div>
                            <h1 class="editorial-title text-7xl md:text-[9rem] text-charcoal mb-4">Nota</h1>
                            <div class="bg-daffodil h-1 w-16 md:w-24"></div>
                        </div>
                        <div class="text-right pt-4 md:pt-8">
                            <p id="prev-no" class="text-xl md:text-3xl font-display italic">#2026-001</p>
                            <p id="prev-date" class="text-[9px] md:text-[10px] uppercase tracking-widest font-bold text-spring-green mt-1 md:mt-2">Marzo 2026</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-16 md:mb-40">
                        <div class="md:col-span-8">
                            <span class="text-[10px] font-black uppercase tracking-widest text-spring-green block mb-4 md:mb-8">Facturado a</span>
                            <h2 id="prev-client-name" class="editorial-title text-5xl md:text-8xl text-charcoal leading-[0.85]">The<br>Botanical Club</h2>
                        </div>
                        <div class="md:col-span-4 flex flex-col justify-end text-left md:text-right md:border-r-4 border-daffodil md:pr-8">
                            <p id="prev-client-email" class="text-lg md:text-xl font-medium mb-1">billing@botanical.club</p>
                            <p id="prev-client-address" class="text-[10px] uppercase tracking-[0.2em] font-bold opacity-40">CDMX, México</p>
                        </div>
                    </div>

                    <table class="boutique-table">
                        <thead>
                            <tr>
                                <th class="w-1/2 md:w-2/3">Descripción</th>
                                <th class="text-center">Cant.</th>
                                <th class="text-right">Monto</th>
                            </tr>
                        </thead>
                        <tbody id="prev-table-body"></tbody>
                    </table>

                    <div class="mt-12 md:mt-20 flex justify-end">
                        <div class="w-full max-w-[95%] md:w-80 bg-sage-light/30 p-4 md:p-8 rounded-[1.5rem] md:rounded-[2rem]">
                            <div class="flex justify-between mb-4 opacity-40 text-[9px] md:text-[10px] uppercase font-black tracking-widest">
                                <span>Subtotal</span>
                                <span id="prev-subtotal">$0.00</span>
                            </div>
                            <div class="total-container flex justify-between items-center pt-4 md:pt-6 border-t-2 border-daffodil">
                                <span class="total-label editorial-title text-xl md:text-3xl italic">Total a Pagar</span>
                                <span id="prev-total" class="total-amount text-xl md:text-3xl font-black text-charcoal whitespace-nowrap">$0.00</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="footer-organic">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
                        <div class="max-w-xs">
                            <p class="editorial-title text-4xl md:text-5xl">Gracias.</p>
                            <p class="text-[9px] uppercase tracking-[0.2em] font-bold mt-2 text-spring-green">Por confiar en nuestro proceso creativo.</p>
                        </div>
                        <div class="text-left md:text-right w-full md:w-auto">
                            <div class="h-10 border-b-2 border-daffodil w-40 md:w-56 md:ml-auto mb-3"></div>
                            <p class="text-[10px] uppercase tracking-[0.3em] font-black text-charcoal">Dirección de Estudio</p>
                            <p class="text-[9px] opacity-40 uppercase tracking-widest mt-1">Nota Digital Studio</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        let items = [
            { id: Date.now(), desc: 'Arquitectura de UI Orgánica', qty: 1, price: 3200 }
        ];

        function addItem() {
            items.push({ id: Date.now(), desc: '', qty: 1, price: 0 });
            renderEditor();
            updatePreview();
        }

        function removeItem(id) {
            if (items.length <= 1) return;
            items = items.filter(item => item.id !== id);
            renderEditor();
            updatePreview();
        }

        function updateItem(id, field, value) {
            const item = items.find(i => i.id === id);
            if (item) {
                item[field] = field === 'desc' ? value : parseFloat(value) || 0;
                updatePreview();
            }
        }

        function renderEditor() {
            const container = document.getElementById('items-editor-container');
            container.innerHTML = items.map(item => `
                <div class="relative bg-white/60 p-6 md:p-8 rounded-[1.5rem] md:rounded-[2.5rem] mb-6 border border-white shadow-sm">
                    <button onclick="removeItem(${item.id})" class="absolute top-4 right-4 text-charcoal opacity-30 hover:opacity-100 transition-opacity">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
                    </button>
                    <div class="mb-4">
                        <label class="input-label-hint">Descripción de Línea</label>
                        <input type="text" class="w-full bg-transparent border-b border-sage-light py-2 text-lg md:text-xl font-display italic focus:outline-none focus:border-daffodil" value="${item.desc}" oninput="updateItem(${item.id}, 'desc', this.value)">
                    </div>
                    <div class="grid grid-cols-2 gap-4 md:gap-6">
                        <div><label class="input-label-hint">Cant.</label><input type="number" class="input-glass text-sm" value="${item.qty}" oninput="updateItem(${item.id}, 'qty', this.value)"></div>
                        <div><label class="input-label-hint">Precio</label><input type="number" class="input-glass text-sm" value="${item.price}" oninput="updateItem(${item.id}, 'price', this.value)"></div>
                    </div>
                </div>
            `).join('');
        }

        function togglePreview(show) {
            document.getElementById('preview-modal').classList.toggle('active', show);
            if (show) updatePreview();
        }

        function updatePreview() {
            document.getElementById('prev-no').innerText = document.getElementById('edit-no').value;
            document.getElementById('prev-date').innerText = document.getElementById('edit-date').value;
            
            const name = document.getElementById('edit-client-name').value;
            const parts = name.trim().split(' ');
            document.getElementById('prev-client-name').innerHTML = parts.length > 1 ? `${parts[0]}<br>${parts.slice(1).join(' ')}` : name;
            
            document.getElementById('prev-client-email').innerText = document.getElementById('edit-client-email').value;
            document.getElementById('prev-client-address').innerText = document.getElementById('edit-client-address').value;

            const tbody = document.getElementById('prev-table-body');
            let subtotal = 0;
            
            tbody.innerHTML = items.map(item => {
                const amount = item.qty * item.price;
                subtotal += amount;
                return `
                    <tr>
                        <td class="font-display italic text-lg md:text-xl py-4 md:py-8">${item.desc || 'Servicio Creativo'}</td>
                        <td class="text-center font-bold opacity-30">${item.qty}</td>
                        <td class="text-right font-bold text-charcoal">$ ${amount.toLocaleString('es-MX')}</td>
                    </tr>
                `;
            }).join('');

            const fmt = (v) => '$ ' + v.toLocaleString('es-MX', {minimumFractionDigits: 2});
            document.getElementById('prev-subtotal').innerText = fmt(subtotal);
            document.getElementById('prev-total').innerText = fmt(subtotal);
        }

        async function exportToPDF() {
            const loader = document.getElementById('export-loader');
            loader.style.display = 'flex';
            
            // Aseguramos que la vista previa esté actualizada antes de capturar
            updatePreview();
            
            const element = document.getElementById('invoice-preview');
            const folio = document.getElementById('edit-no').value || 'nota';
            
            const opt = {
                margin: 0,
                filename: `Nota_Boutique_${folio}.pdf`,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { 
                    scale: 2, 
                    useCORS: true,
                    letterRendering: true,
                    scrollY: 0
                },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            try {
                await html2pdf().set(opt).from(element).save();
            } catch (error) {
                console.error("Error al exportar:", error);
            } finally {
                loader.style.display = 'none';
            }
        }

        window.onload = () => { renderEditor(); updatePreview(); };
    </script>
</body>
</html>
